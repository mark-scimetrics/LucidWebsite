---
import { APP_LOGIN_URL } from '../consts';

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => href.startsWith('/') && (path === href || path.startsWith(`${href}/`));

// Guides still points at the legacy page; it moves to /guides in phase 3.
const navLinks = [
  { href: '/how-it-works', label: 'How it works' },
  { href: '/demo', label: 'Demo' },
  { href: '/pricing', label: 'Pricing' },
  { href: 'guides/index.html', label: 'Guides' },
  { href: '/about', label: 'About' },
];

const menuLinks = [
  { href: '/how-it-works', label: 'How it works' },
  { href: '/demo', label: '60-second demo' },
  { href: '/pricing', label: 'Pricing' },
  { href: '/your-data', label: 'Your data' },
  { href: 'guides/index.html', label: 'Guides' },
  { href: '/cashflow-index', label: 'Cashflow Index' },
  { href: '/glossary', label: 'Glossary' },
  { href: '/about', label: 'About us' },
];
---

<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/" aria-label="Lucid Cashflow home"
      ><span class="wm">Lucid<span class="dot">.</span></span><span class="wm-sub">CASHFLOW</span></a
    >
    <nav class="nav" aria-label="Main">
      {
        navLinks.map((link) => (
          <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
            {link.label}
          </a>
        ))
      }
      <a class="btn btn-primary btn-sm" href={APP_LOGIN_URL}>Build your forecast free</a>
    </nav>
    <details class="menu">
      <summary>Menu</summary>
      <nav aria-label="Mobile">
        {
          menuLinks.map((link) => (
            <a href={link.href}>{link.label}</a>
          ))
        }
        <a class="btn btn-primary btn-sm" href={APP_LOGIN_URL}>Build your forecast free</a>
      </nav>
    </details>
  </div>
</header>
