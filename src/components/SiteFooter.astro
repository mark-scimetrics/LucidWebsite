---
import { COMPANY } from '../data/company';
---

<footer class="site-footer">
  <div class="wrap">
    <div class="foot-grid">
      <div style="display:grid;gap:12px;align-content:start">
        <a class="brand" href="/"
          ><span class="wm">Lucid<span class="dot">.</span></span><span class="wm-sub">CASHFLOW</span></a
        >
        <p class="muted">
          Cashflow, sorted. Your cash 13 weeks ahead, a daily verdict, and the cheapest way through.
        </p>
        <p class="muted">hello@lucidcashflow.co.uk</p>
      </div>
      <div>
        <h4>Product</h4>
        <ul>
          <li><a href="/how-it-works">How it works</a></li>
          <li><a href="/demo">60-second demo</a></li>
          <li><a href="/pricing">Pricing</a></li>
          <li><a href="/your-data">Your data</a></li>
        </ul>
      </div>
      <div>
        <h4>Learn</h4>
        <ul>
          <li><a href="/guides">Guides</a></li>
          <li><a href="/cashflow-index">Cashflow Index</a></li>
          <li><a href="/glossary">Glossary</a></li>
        </ul>
      </div>
      <div>
        <h4>Company</h4>
        <ul>
          <li><a href="/about">About us</a></li>
          <li><a href="https://lendinglogic.co.uk/">For partners</a></li>
        </ul>
      </div>
    </div>
    <div class="legal">
      <p>
        Lucid Cashflow is a trading name of {COMPANY.legalName}, registered in England and Wales,
        company number {COMPANY.companyNumber}. Registered office: {COMPANY.registeredOffice}. ICO
        registration: {COMPANY.icoNumber}.
      </p>
      <p>
        Lucid is not a lender and does not guarantee funding. We introduce limited companies to
        commercial lenders only with your permission, and we tell you if we are paid for an
        introduction.
      </p>
      <p>
        © 2026 Lending Logic Ltd. Xero is a trademark of Xero Limited; Lucid is not affiliated with
        or endorsed by Xero.
      </p>
    </div>
  </div>
</footer>
