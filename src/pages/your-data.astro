---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import Faq from '../components/Faq.astro';

const faqs = [
  {
    "q": "Can Lucid change anything in my Xero?",
    "a": "No. The connection is read-only. Lucid can’t create, edit or delete records, and it can’t move money."
  },
  {
    "q": "Will a lender see my data?",
    "a": "Only if you choose to apply, and only the lender you approve. You see exactly what will be shared before anything is sent."
  },
  {
    "q": "How do I disconnect?",
    "a": "From your Lucid settings or from Xero’s connected apps page, at any time. You can also ask us to delete your data."
  }
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map((faq) => ({
      "@type": "Question",
      "name": faq.q,
      "acceptedAnswer": { "@type": "Answer", "text": faq.a },
    })),
  },
];
---

<BaseLayout
  title="Your Data and Security · Lucid Cashflow"
  description="How Lucid handles your data: read-only access to Xero, nothing shared without your permission, and the right to disconnect and delete at any time."
  jsonLd={jsonLd}
>
<section class="page-hero"><div class="wrap narrow">
<span class="eyebrow">Your data</span>
<h1>Your data, your control.</h1>
<p class="lede">Your numbers are the most private thing your business has. Here is exactly what Lucid does with them, in plain English.</p>
</div></section>
<section style="padding-top:32px"><div class="wrap grid-2">
<div class="card"><h3>Read-only, always</h3><p>Lucid connects through Xero’s official sign-in with read-only access. We can’t change your books, and we can’t move money.</p></div>
<div class="card"><h3>Nothing shared without a yes</h3><p>No lender, broker or partner sees your data unless you approve it, for that named organisation, each time. You see what will be shared first.</p></div>
<div class="card"><h3>Disconnect and delete</h3><p>Disconnect at any time from Lucid or from Xero. Ask us to delete your data and we will, apart from records we must keep by law. <span class="placeholder">[Retention period to confirm]</span></p></div>
<div class="card"><h3>Anonymised insights</h3><p>We use anonymised, aggregated figures, never anything that identifies you or your business, to improve forecasts and publish the UK SME Cashflow Index. We explain this before you connect. <span class="placeholder">[Opt-out mechanism to confirm]</span></p></div>
<div class="card"><h3>How it’s protected</h3><p><span class="placeholder">[Mark: hosting location, encryption in transit and at rest, access controls, AI provider and its data terms]</span></p></div>
<div class="card"><h3>Who we are</h3><p>Lucid Cashflow is run by Lending Logic Ltd, registered with the Information Commissioner’s Office (<span class="placeholder">[ICO number]</span>). Questions to privacy@lucidcashflow.co.uk.</p></div>
</div></section>
<section class="band"><div class="wrap narrow" style="display:grid;gap:24px">
<h2>Common questions</h2>
<Faq items={faqs} />
</div></section>
<CtaBand title="See your next 13 weeks in minutes." text="Free to start. Read-only connection to Xero. No card needed." />
</BaseLayout>
