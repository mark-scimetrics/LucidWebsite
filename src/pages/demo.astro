---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';

const jsonLd: never[] = [];
---

<BaseLayout
  title="Lucid Demo · Lucid Cashflow"
  description="See Lucid build a 13-week cashflow forecast for a real-looking business in 60 seconds, then spot a squeeze and rank the ways through."
  jsonLd={jsonLd}
>
<section class="page-hero"><div class="wrap">
<span class="eyebrow">60-second demo</span>
<h1>See Lucid on a real business.</h1>
<p class="lede">Watch Lucid connect to a demo company, build its 13-week forecast, spot a VAT squeeze in week 9, and rank the ways through.</p>
</div></section>
<section style="padding-top:32px"><div class="wrap" style="display:grid;gap:32px">
<div class="card" style="padding:0;overflow:hidden;background:#000"><video controls playsinline preload="auto" style="display:block;width:100%;height:auto;aspect-ratio:16/9" aria-label="60-second Lucid demo"><source src="/assets/Lucid_demo_refined.mp4" type="video/mp4">Your browser does not support video. <a href="/assets/Lucid_demo_refined.mp4">Download the demo</a>.</video></div>
<div class="grid-3">
<div class="card"><span class="step-num">0:00</span><h3>Connect</h3><p>A demo company connects through Xero’s sign-in and answers the five questions.</p></div>
<div class="card"><span class="step-num">0:20</span><h3>Forecast</h3><p>Thirteen weeks of cash appear, built from how each customer actually pays.</p></div>
<div class="card"><span class="step-num">0:40</span><h3>Verdict</h3><p>Lucid flags week 9 and shows three ways through, starting with the free ones.</p></div>
</div></div></section>
<CtaBand title="Rather see your own numbers?" text="Connect Xero and see your 13 weeks. Or book a 20-minute walkthrough with a founder." secondaryHref="mailto:hello@lucidcashflow.co.uk" secondaryLabel="Book a walkthrough" />
</BaseLayout>
